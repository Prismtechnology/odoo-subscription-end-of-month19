<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_end_of_the_month_order_form" model="ir.ui.view">
        <field name="name">sale.order.subscription.end.of.the.month.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="invoice_timing" widget="radio" options="{'horizontal': true}" 
                       invisible="not plan_id"/>
            </xpath>
        </field>
    </record>
</odoo>
